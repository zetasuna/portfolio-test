# Copy this file to .env and replace every placeholder before first startup.
PROJECT_DIR=REPLACE_WITH_ABSOLUTE_PATH_TO_PROJECT_DIRECTORY
POSTGRES_DB=portfolio
# Bootstrap administrator for the PostgreSQL image; the Go app does not use this role.
POSTGRES_USER=portfolio_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_BOOTSTRAP_SECRET
# Least-privilege runtime role used by Go and integration tests.
APP_DB_USER=portfolio_app
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_SECRET
# Separate database reserved for integration tests; same PostgreSQL service, no extra container.
TEST_DB_NAME=portfolio_test

# Docker Hub image. Local development uses portfolio-crud:local by default.
APP_IMAGE=portfolio-crud:local

# App/security settings
SESSION_TTL=12h
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8080
TRUST_PROXY_HEADERS=true
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,app1,app2,app3,host.docker.internal
OTEL_TRACES_SAMPLER_ARG=1.0

# Monitoring and Jenkins local-only host ports
APP_HOST_PORT=8080
GRAFANA_HOST_PORT=3000
JENKINS_HOST_PORT=8081
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Match the numeric group ID that owns /var/run/docker.sock on your host.
DOCKER_GID=998

# These do not enable internet exposure. All host port binds default to localhost.
